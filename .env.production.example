# ColdChain — production environment for a single facility box.
# Copy to `.env.production` and fill in, OR let scripts/bootstrap.sh generate it.
# NEVER commit .env.production (it's gitignored).
#
# Run the stack with:
#   docker compose --env-file .env.production up -d --build

# --- Database (Postgres runs inside the compose stack) ---
POSTGRES_USER=coldchain
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=coldchain

# --- Auth secrets — generate each with:  openssl rand -hex 48 ---
JWT_SECRET=CHANGE_ME_long_random_hex
JWT_REFRESH_SECRET=CHANGE_ME_different_long_random_hex

# Encrypts secrets at rest in the settings JSON (SMTP/API-key app-password for
# email, TOTP secrets). If unset, a key is derived from JWT_SECRET — fine for a
# single box, but then rotating JWT_SECRET invalidates every saved secret (just
# re-enter them in Settings → Email / re-enroll 2FA). Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=CHANGE_ME_32_byte_hex

# Optional. Minimum password length (default 10). Common passwords are always
# blocked; there are no composition rules (per NIST SP 800-63B-4). Raise to 15
# if you ever run accounts without 2FA enrolled.
# PASSWORD_MIN_LENGTH=10

# Optional. Access-token lifetime (default 30m). Signed-in browsers refresh
# silently, so users never notice. '8h' restores the pre-Phase-18 behavior.
# JWT_ACCESS_TTL=30m

# --- App ---
# Origin staff use to reach the box. With same-origin HTTP this is mostly informational
# (CORS rarely fires). Update when you serve a hostname over HTTPS (Phase C).
PUBLIC_ORIGIN=http://coldchain.local
LOG_LEVEL=info

# --- Container images (CI/CD rollout, Phase B) ---
# Where the box pulls images from, and which release tag it runs. CI publishes images to
# GHCR on each v* tag; scripts/update.sh pulls + migrates + health-checks + rolls back.
# For a box that builds locally, the defaults are fine.
IMAGE_REGISTRY=ghcr.io/izhanjunaid
COLDCHAIN_TAG=latest
# Optional heartbeat URL (e.g. healthchecks.io) pinged by update.sh and backup.sh.
HEALTHCHECK_URL=

# --- Backups (scripts/backup.sh) ---
# Optional: encrypt dumps at rest (openssl AES-256). Leave blank to skip encryption.
BACKUP_PASSPHRASE=
# Optional: rclone remote for offsite copies, e.g. "r2:coldchain-backups".
# Configure once with `rclone config`. Leave blank to skip offsite sync.
BACKUP_RCLONE_REMOTE=
# How many days of local backups to keep.
BACKUP_RETENTION_DAYS=30
