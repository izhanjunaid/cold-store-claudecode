# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coldchain?schema=public"

# Auth
JWT_SECRET="your-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"
# Password length floor (NIST 800-63B-4: blocklist enforced too, no composition rules).
# PASSWORD_MIN_LENGTH=10
# Access-token lifetime (default 30m; the web app silently refreshes on expiry).
# JWT_ACCESS_TTL=30m

# API
PORT=3001
CORS_ORIGIN="http://localhost:3000"
LOG_LEVEL="info"

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:3001"
