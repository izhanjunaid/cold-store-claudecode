generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  OWNER
  MANAGER
  ACCOUNTANT
  OPERATOR
  SECURITY
  VIEWER
}

enum AuditAction {
  INSERT
  UPDATE
}

// ============================================================
// ENUMS (Phase 1)
// ============================================================

enum PartyType {
  FARMER
  TRADER
  ARHTI
  BUYER
  OTHER
}

enum TemperatureSource {
  MANUAL
  SENSOR
}

// ============================================================
// ENUMS (Phase 2)
// ============================================================

enum RateType {
  SEASONAL_PER_BAG
  MONTHLY_PER_BAG
  DAILY_PER_BAG
}

enum ServiceUnitType {
  PER_BAG
  PER_TON
  FLAT
}

enum LotStatus {
  ACTIVE
  CLOSED
  SUSPENDED
}

enum BookType {
  PACCI
  KATCHI
}

enum OwnershipEventType {
  INITIAL
  TRANSFER_IN
  TRANSFER_OUT
}

// ============================================================
// ENUMS (Phase 4)
// ============================================================

enum WithdrawalType {
  FULL
  PARTIAL
}

enum OutboundStatus {
  PENDING
  WEIGHED
  DISPATCHED
  CANCELLED
  DISPUTED
}

// ============================================================
// ENUMS (Phase 5)
// ============================================================

enum InvoiceStatus {
  DRAFT
  FINALIZED
  VOID
  WRITTEN_OFF
}

enum DiscountType {
  PERCENT
  FIXED
}

enum InvoiceLineType {
  STORAGE
  SERVICE
  ADJUSTMENT
  ADVANCE_APPLIED
}

// ============================================================
// ENUMS (Phase 7)
// ============================================================

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  MOBILE_WALLET
}

enum PaymentStatus {
  RECORDED
  ALLOCATED
  ADVANCE
  DISHONOURED
}

enum ClearanceStatus {
  NA
  PENDING
  CLEARED
  BOUNCED
}

// ============================================================
// ENUMS (Phase 8 — Accounting)
// ============================================================

enum AccountClass {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COST_OF_SERVICE
  EXPENSE
}

enum AccountType {
  HEADER
  DETAIL
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum EntryType {
  INVOICE
  PAYMENT
  ADVANCE
  ADVANCE_APPLIED
  CREDIT_NOTE
  ADJUSTMENT
  ACCRUAL
  BAD_DEBT
  REVERSAL
  SPOILAGE
  SPOILAGE_SETTLEMENT
  DEPRECIATION
  ASSET_PURCHASE
  ASSET_DISPOSAL
  PAYROLL
  PAYROLL_PAYMENT
  GOVT_REMITTANCE
  EXPENSE
  PESHGI_ISSUE
  PESHGI_RECOVERY
  PESHGI_WRITE_OFF
  SURCHARGE
}

enum PostingStatus {
  AUTO_DRAFT
  POSTED
  REVERSED
}

enum CreditNoteStatus {
  ISSUED
  APPLIED
  CANCELLED
}

// ============================================================
// ENUMS (Phase 8B — Cost-side)
// ============================================================

enum AssetCategory {
  COLD_PLANT
  BUILDING
  VEHICLE
  COMPUTER
  OTHER
}

enum DepreciationMethod {
  SLM
  WDV
}

enum FixedAssetStatus {
  PLANNED
  PURCHASED
  IN_SERVICE
  DISPOSED
  WRITTEN_OFF
}

enum DepreciationScheduleStatus {
  PENDING
  POSTED
}

enum EmployeeType {
  SALARIED
  DAILY_WAGE
}

enum PayrollType {
  MONTHLY_SALARY
  DAILY_WAGES
}

enum PayrollRunStatus {
  DRAFT
  FINALIZED
  PAID
}

enum ExpenseVoucherStatus {
  DRAFT
  APPROVED
  ACCRUED
  PAID
  CANCELLED
}

enum ExpensePaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
}

enum PartyLoanStatus {
  ACTIVE
  RECOVERED
  WRITTEN_OFF
}

enum RepaymentMethod {
  CASH
  BANK_TRANSFER
  DEDUCTED_FROM_PRODUCE
}

// ============================================================
// ENUMS (Phase 9 — Gate Pass + Peshgi UI)
// ============================================================

enum GatePassDirection {
  INWARD
  OUTWARD
}

enum GatePassStatus {
  ARRIVED
  WEIGHING
  CLEARED
  CANCELLED
}

// ============================================================
// FOUNDATION TABLES (Migration 0001)
// ============================================================

model Facility {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  address   String?  @db.Text
  city      String   @default("Lahore") @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  gstNumber String?  @map("gst_number") @db.VarChar(50)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  users          User[]
  auditLogs      AuditLog[]
  refreshTokens  RefreshToken[]
  parties        Party[]
  chambers       Chamber[]
  ratePlans      RatePlan[]
  serviceCharges ServiceCharge[]
  lots           Lot[]
  outboundEvents OutboundEvent[]
  invoices       Invoice[]
  payments       Payment[]

  chartOfAccounts ChartOfAccounts[]
  journalEntries  JournalEntry[]
  creditNotes     CreditNote[]
  periodLocks     PeriodLock[]

  fixedAssets     FixedAsset[]
  employees       Employee[]
  payrollRuns     PayrollRun[]
  expenseVouchers ExpenseVoucher[]
  partyLoans      PartyLoan[]
  gatePasses      GatePass[]
  invoiceSurcharges InvoiceSurcharge[]

  @@map("facilities")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  facilityId       String    @map("facility_id") @db.Uuid
  email            String    @db.VarChar(200)
  passwordHash     String    @map("password_hash") @db.VarChar(200)
  name             String    @db.VarChar(200)
  nameUrdu         String?   @map("name_urdu") @db.VarChar(200)
  role             UserRole
  isActive         Boolean   @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz()
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz()
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  facility              Facility           @relation(fields: [facilityId], references: [id])
  refreshTokens         RefreshToken[]
  partiesCreated        Party[]            @relation("PartyCreatedBy")
  temperatureLogs       TemperatureLog[]
  lotsCreated           Lot[]              @relation("LotCreatedBy")
  ownershipEvents       OwnershipHistory[]
  outboundCreated       OutboundEvent[]    @relation("OutboundCreatedBy")
  invoicesCreated       Invoice[]          @relation("InvoiceCreatedBy")
  invoicesFinalized     Invoice[]          @relation("InvoiceFinalizedBy")
  paymentsCreated       Payment[]          @relation("PaymentCreatedBy")
  journalEntriesCreated JournalEntry[]     @relation("JournalEntryCreatedBy")
  creditNotesCreated    CreditNote[]       @relation("CreditNoteCreatedBy")
  periodLocksCreated    PeriodLock[]       @relation("PeriodLockLockedBy")
  periodLocksUnlocked   PeriodLock[]       @relation("PeriodLockUnlockedBy")

  fixedAssetsCreated      FixedAsset[]         @relation("FixedAssetCreatedBy")
  employeesCreated        Employee[]           @relation("EmployeeCreatedBy")
  payrollRunsFinalized    PayrollRun[]         @relation("PayrollRunFinalizedBy")
  expenseVouchersCreated  ExpenseVoucher[]     @relation("ExpenseVoucherCreatedBy")
  expenseVouchersApproved ExpenseVoucher[]     @relation("ExpenseVoucherApprovedBy")
  partyLoansCreated       PartyLoan[]          @relation("PartyLoanCreatedBy")
  loanRepaymentsCreated   PartyLoanRepayment[] @relation("PartyLoanRepaymentCreatedBy")
  gatePassesCreated       GatePass[]           @relation("GatePassCreatedBy")
  surchargesCreated       InvoiceSurcharge[]   @relation("InvoiceSurchargeCreatedBy")

  @@unique([facilityId, email])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  facilityId String    @map("facility_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(200)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user     User     @relation(fields: [userId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  facilityId String      @map("facility_id") @db.Uuid
  tableName  String      @map("table_name") @db.VarChar(100)
  recordId   String      @map("record_id") @db.Uuid
  action     AuditAction
  changedBy  String      @map("changed_by") @db.Uuid
  changedAt  DateTime    @default(now()) @map("changed_at") @db.Timestamptz()
  oldValues  Json?       @map("old_values")
  newValues  Json        @map("new_values")
  reason     String?     @db.Text

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId, tableName, recordId])
  @@index([changedAt])
  @@map("audit_log")
}

// ============================================================
// PHASE 1: PARTIES, COMMODITIES, CHAMBERS (Migration 0002)
// ============================================================

model Party {
  id              String    @id @default(uuid()) @db.Uuid
  facilityId      String    @map("facility_id") @db.Uuid
  name            String    @db.VarChar(200)
  nameUrdu        String?   @map("name_urdu") @db.VarChar(200)
  partyType       PartyType @map("party_type")
  phonePrimary    String    @map("phone_primary") @db.VarChar(20)
  phoneSecondary  String?   @map("phone_secondary") @db.VarChar(20)
  address         String?   @db.Text
  cnic            String?   @db.VarChar(15)
  parentArhtiId   String?   @map("parent_arhti_id") @db.Uuid
  creditLimitPkr  Decimal?  @map("credit_limit_pkr") @db.Decimal(12, 2)
  creditTermsDays Int       @default(30) @map("credit_terms_days")
  isActive        Boolean   @default(true) @map("is_active")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  createdBy       String    @map("created_by") @db.Uuid

  facility          Facility           @relation(fields: [facilityId], references: [id])
  parentArhti       Party?             @relation("PartyArhtiLink", fields: [parentArhtiId], references: [id])
  childParties      Party[]            @relation("PartyArhtiLink")
  createdByUser     User               @relation("PartyCreatedBy", fields: [createdBy], references: [id])
  lotsOwned         Lot[]              @relation("LotOwner")
  lotsBilled        Lot[]              @relation("LotBillingParty")
  ownershipFrom     OwnershipHistory[] @relation("OwnershipFromParty")
  ownershipTo       OwnershipHistory[] @relation("OwnershipToParty")
  outboundReceived  OutboundEvent[]    @relation("OutboundReceiver")
  invoicesBilled    Invoice[]          @relation("InvoiceBillingParty")
  payments          Payment[]
  journalEntryLines JournalEntryLine[]
  creditNotes       CreditNote[]       @relation("CreditNoteBillingParty")
  partyLoans        PartyLoan[]
  gatePassesDeposited    GatePass[]      @relation("GatePassDepositor")
  outboundOwnerSnapshots OutboundEvent[] @relation("OutboundOwnerSnapshot")

  @@index([facilityId, phonePrimary])
  @@index([facilityId, partyType])
  @@index([parentArhtiId])
  @@map("parties")
}

model Commodity {
  id                      String  @id @default(uuid()) @db.Uuid
  name                    String  @unique @db.VarChar(100)
  unitLabel               String  @map("unit_label") @db.VarChar(20)
  defaultStorageDaysAlert Int?    @map("default_storage_days_alert")
  isActive                Boolean @default(true) @map("is_active")

  varieties Variety[]
  chambers  Chamber[]  @relation("ChamberCommodityRestriction")
  ratePlans RatePlan[]
  lots      Lot[]

  @@map("commodities")
}

model Variety {
  id          String  @id @default(uuid()) @db.Uuid
  commodityId String  @map("commodity_id") @db.Uuid
  name        String  @db.VarChar(100)
  isActive    Boolean @default(true) @map("is_active")

  commodity Commodity @relation(fields: [commodityId], references: [id])
  lots      Lot[]

  @@map("varieties")
}

model Chamber {
  id                     String   @id @default(uuid()) @db.Uuid
  facilityId             String   @map("facility_id") @db.Uuid
  name                   String   @db.VarChar(100)
  commodityRestrictionId String?  @map("commodity_restriction") @db.Uuid
  maxCapacityBags        Int      @map("max_capacity_bags")
  temperatureMinC        Decimal? @map("temperature_min_c") @db.Decimal(4, 1)
  temperatureMaxC        Decimal? @map("temperature_max_c") @db.Decimal(4, 1)
  isActive               Boolean  @default(true) @map("is_active")
  notes                  String?  @db.Text

  facility             Facility         @relation(fields: [facilityId], references: [id])
  commodityRestriction Commodity?       @relation("ChamberCommodityRestriction", fields: [commodityRestrictionId], references: [id])
  temperatureLogs      TemperatureLog[]
  lots                 Lot[]

  @@map("chambers")
}

model TemperatureLog {
  id           String            @id @default(uuid()) @db.Uuid
  chamberId    String            @map("chamber_id") @db.Uuid
  recordedAt   DateTime          @map("recorded_at") @db.Timestamptz()
  temperatureC Decimal           @map("temperature_c") @db.Decimal(4, 1)
  recordedBy   String            @map("recorded_by") @db.Uuid
  source       TemperatureSource @default(MANUAL)

  chamber        Chamber @relation(fields: [chamberId], references: [id])
  recordedByUser User    @relation(fields: [recordedBy], references: [id])

  @@index([chamberId, recordedAt])
  @@map("temperature_logs")
}

// ============================================================
// PHASE 2: LOTS, RATE PLANS, SERVICE CHARGES (Migration 0003)
// ============================================================

model RatePlan {
  id                 String    @id @default(uuid()) @db.Uuid
  facilityId         String    @map("facility_id") @db.Uuid
  name               String    @db.VarChar(200)
  commodityId        String?   @map("commodity_id") @db.Uuid
  rateType           RateType  @map("rate_type")
  rateAmountPkr      Decimal   @map("rate_amount_pkr") @db.Decimal(10, 2)
  seasonStartDate    DateTime? @map("season_start_date") @db.Date
  seasonEndDate      DateTime? @map("season_end_date") @db.Date
  minBillingDays     Int       @default(1) @map("min_billing_days")
  revenueAccountCode String?   @map("revenue_account_code") @db.VarChar(10)
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  facility     Facility          @relation(fields: [facilityId], references: [id])
  commodity    Commodity?        @relation(fields: [commodityId], references: [id])
  lots         Lot[]
  invoiceLines InvoiceLineItem[]

  @@index([facilityId, isActive])
  @@map("rate_plans")
}

model ServiceCharge {
  id                 String          @id @default(uuid()) @db.Uuid
  facilityId         String          @map("facility_id") @db.Uuid
  name               String          @db.VarChar(100)
  unitType           ServiceUnitType @map("unit_type")
  unitPricePkr       Decimal         @map("unit_price_pkr") @db.Decimal(10, 2)
  revenueAccountCode String?         @map("revenue_account_code") @db.VarChar(10)
  isActive           Boolean         @default(true) @map("is_active")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  facility     Facility          @relation(fields: [facilityId], references: [id])
  invoiceLines InvoiceLineItem[]

  @@unique([facilityId, name])
  @@map("service_charges")
}

model Lot {
  id                  String    @id @default(uuid()) @db.Uuid
  facilityId          String    @map("facility_id") @db.Uuid
  lotNumber           String    @map("lot_number") @db.VarChar(30)
  chamberId           String    @map("chamber_id") @db.Uuid
  ownerPartyId        String    @map("owner_party_id") @db.Uuid
  billingPartyId      String    @map("billing_party_id") @db.Uuid
  commodityId         String    @map("commodity_id") @db.Uuid
  varietyId           String?   @map("variety_id") @db.Uuid
  ratePlanId          String    @map("rate_plan_id") @db.Uuid
  quantityBags        Int       @map("quantity_bags")
  currentBalanceBags  Int       @map("current_balance_bags")
  acceptedWeightKg    Decimal   @map("accepted_weight_kg") @db.Decimal(10, 2)
  declaredWeightKg    Decimal?  @map("declared_weight_kg") @db.Decimal(10, 2)
  weightDisputeFlag   Boolean   @default(false) @map("weight_dispute_flag")
  weightDisputeNote   String?   @map("weight_dispute_note") @db.Text
  qualityGradeInbound String?   @map("quality_grade_inbound") @db.VarChar(2)
  inboundDate         DateTime  @map("inbound_date") @db.Date
  entryDate           DateTime  @map("entry_date") @db.Date
  parentLotId         String?   @map("parent_lot_id") @db.Uuid
  vehicleNumber       String?   @map("vehicle_number") @db.VarChar(20)
  marka               String?   @map("marka") @db.VarChar(100)
  status              LotStatus @default(ACTIVE)
  closedAt            DateTime? @map("closed_at") @db.Date
  bookType            BookType  @default(PACCI) @map("book_type")
  notes               String?   @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  createdBy           String    @map("created_by") @db.Uuid

  facility          Facility           @relation(fields: [facilityId], references: [id])
  chamber           Chamber            @relation(fields: [chamberId], references: [id])
  ownerParty        Party              @relation("LotOwner", fields: [ownerPartyId], references: [id])
  billingParty      Party              @relation("LotBillingParty", fields: [billingPartyId], references: [id])
  commodity         Commodity          @relation(fields: [commodityId], references: [id])
  variety           Variety?           @relation(fields: [varietyId], references: [id])
  ratePlan          RatePlan           @relation(fields: [ratePlanId], references: [id])
  parentLot         Lot?               @relation("LotParent", fields: [parentLotId], references: [id])
  childLots         Lot[]              @relation("LotParent")
  createdByUser     User               @relation("LotCreatedBy", fields: [createdBy], references: [id])
  ownershipHistory  OwnershipHistory[]
  outboundEvents    OutboundEvent[]
  invoices          Invoice[]
  journalEntryLines JournalEntryLine[]
  gatePasses        GatePass[]

  @@unique([facilityId, lotNumber])
  @@index([facilityId, status])
  @@index([ownerPartyId, status])
  @@index([chamberId, status])
  @@index([inboundDate])
  @@index([facilityId, status, inboundDate])
  @@index([facilityId, marka])
  @@map("lots")
}

model OwnershipHistory {
  id               String             @id @default(uuid()) @db.Uuid
  lotId            String             @map("lot_id") @db.Uuid
  eventType        OwnershipEventType @map("event_type")
  fromPartyId      String?            @map("from_party_id") @db.Uuid
  toPartyId        String             @map("to_party_id") @db.Uuid
  quantityBags     Int                @map("quantity_bags")
  transferPricePkr Decimal?           @map("transfer_price_pkr") @db.Decimal(12, 2)
  effectiveDate    DateTime           @map("effective_date") @db.Date
  operatorId       String             @map("operator_id") @db.Uuid
  notes            String?            @db.Text
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  lot       Lot    @relation(fields: [lotId], references: [id])
  fromParty Party? @relation("OwnershipFromParty", fields: [fromPartyId], references: [id])
  toParty   Party  @relation("OwnershipToParty", fields: [toPartyId], references: [id])
  operator  User   @relation(fields: [operatorId], references: [id])

  @@index([lotId, effectiveDate])
  @@map("ownership_history")
}

// ============================================================
// PHASE 4: OUTBOUND EVENTS (Migration 0004)
// ============================================================

model OutboundEvent {
  id                    String         @id @default(uuid()) @db.Uuid
  lotId                 String         @map("lot_id") @db.Uuid
  facilityId            String         @map("facility_id") @db.Uuid
  withdrawalType        WithdrawalType @map("withdrawal_type")
  quantityWithdrawnBags Int            @map("quantity_withdrawn_bags")
  outboundWeightKg      Decimal?       @map("outbound_weight_kg") @db.Decimal(10, 2)
  outboundDate          DateTime       @map("outbound_date") @db.Date
  receivingPartyId      String?        @map("receiving_party_id") @db.Uuid
  ownerPartyIdSnapshot  String?        @map("owner_party_id_snapshot") @db.Uuid
  vehicleNumber         String?        @map("vehicle_number") @db.VarChar(20)
  dispatchNoteNumber    String?        @map("dispatch_note_number") @db.VarChar(30)
  status                OutboundStatus @default(PENDING)
  notes                 String?        @db.Text
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  createdBy             String         @map("created_by") @db.Uuid

  lot                Lot      @relation(fields: [lotId], references: [id])
  facility           Facility @relation(fields: [facilityId], references: [id])
  receivingParty     Party?   @relation("OutboundReceiver", fields: [receivingPartyId], references: [id])
  ownerPartySnapshot Party?   @relation("OutboundOwnerSnapshot", fields: [ownerPartyIdSnapshot], references: [id])
  createdByUser      User     @relation("OutboundCreatedBy", fields: [createdBy], references: [id])
  invoice        Invoice?
  gatePasses     GatePass[]

  @@unique([facilityId, dispatchNoteNumber])
  @@index([lotId])
  @@index([facilityId, status])
  @@index([facilityId, outboundDate, status])
  @@map("outbound_events")
}

// ============================================================
// PHASE 5: BILLING ENGINE — INVOICES (Migration 0005)
// ============================================================

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  facilityId      String        @map("facility_id") @db.Uuid
  invoiceNumber   String?       @map("invoice_number") @db.VarChar(30)
  lotId           String        @map("lot_id") @db.Uuid
  outboundEventId String?       @unique @map("outbound_event_id") @db.Uuid
  billingPartyId  String        @map("billing_party_id") @db.Uuid
  invoiceDate     DateTime      @map("invoice_date") @db.Date
  periodStart     DateTime      @map("period_start") @db.Date
  periodEnd       DateTime      @map("period_end") @db.Date
  subTotalPkr     Decimal       @map("sub_total_pkr") @db.Decimal(12, 2)
  discountType      DiscountType? @map("discount_type")
  discountValue     Decimal?      @map("discount_value") @db.Decimal(12, 2)
  discountAmountPkr Decimal       @default(0) @map("discount_amount_pkr") @db.Decimal(12, 2)
  gstRate         Decimal       @default(0) @map("gst_rate") @db.Decimal(5, 2)
  gstAmountPkr    Decimal       @default(0) @map("gst_amount_pkr") @db.Decimal(12, 2)
  totalPkr        Decimal       @map("total_pkr") @db.Decimal(12, 2)
  amountPaidPkr   Decimal       @default(0) @map("amount_paid_pkr") @db.Decimal(12, 2)
  surchargeTotalPkr Decimal     @default(0) @map("surcharge_total_pkr") @db.Decimal(12, 2)
  status          InvoiceStatus @default(DRAFT)
  finalizedAt     DateTime?     @map("finalized_at") @db.Timestamptz()
  finalizedBy     String?       @map("finalized_by") @db.Uuid
  bookType        BookType      @default(PACCI) @map("book_type")
  journalEntryId  String?       @unique @map("journal_entry_id") @db.Uuid
  notes           String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  createdBy       String        @map("created_by") @db.Uuid

  facility        Facility            @relation(fields: [facilityId], references: [id])
  lot             Lot                 @relation(fields: [lotId], references: [id])
  outboundEvent   OutboundEvent?      @relation(fields: [outboundEventId], references: [id])
