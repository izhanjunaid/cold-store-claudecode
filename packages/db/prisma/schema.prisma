  billLines           BillLine[]
  supplierPayments    SupplierPayment[]
  taxRemittancesOwed  TaxRemittance[]       @relation("TaxRemittanceLiability")
  taxRemittancesPaid  TaxRemittance[]       @relation("TaxRemittancePaidFrom")
  cashTransfersOut    CashTransfer[]        @relation("CashTransferFrom")
  cashTransfersIn     CashTransfer[]        @relation("CashTransferTo")
  ownerEquityMovements OwnerEquityMovement[]

  @@unique([facilityId, accountCode])
