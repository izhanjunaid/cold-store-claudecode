  writeOffJournalEntry JournalEntry?             @relation("EmployeeAdvanceWriteOffJE", fields: [writeOffJournalEntryId], references: [id])
  recoveries           EmployeeAdvanceRecovery[]

  @@unique([facilityId, advanceNumber])
  @@index([facilityId, employeeId])
  @@index([facilityId, status])
  @@map("employee_advances")
}

model EmployeeAdvanceRecovery {
