generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  OWNER
  MANAGER
  ACCOUNTANT
  OPERATOR
  SECURITY
  VIEWER
}

enum AuditAction {
  INSERT
  UPDATE
}

// ============================================================
// ENUMS (Phase 1)
// ============================================================

enum PartyType {
  FARMER
  TRADER
  ARHTI
  BUYER
  OTHER
}

enum TemperatureSource {
  MANUAL
  SENSOR
}

// ============================================================
// FOUNDATION TABLES (Migration 0001)
// ============================================================

model Facility {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(200)
  address    String?  @db.Text
  city       String   @default("Lahore") @db.VarChar(100)
  phone      String?  @db.VarChar(20)
  gstNumber  String?  @map("gst_number") @db.VarChar(50)
  settings   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  users         User[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  parties       Party[]
  chambers      Chamber[]

  @@map("facilities")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  facilityId       String    @map("facility_id") @db.Uuid
  email            String    @db.VarChar(200)
  passwordHash     String    @map("password_hash") @db.VarChar(200)
  name             String    @db.VarChar(200)
  nameUrdu         String?   @map("name_urdu") @db.VarChar(200)
  role             UserRole
  isActive         Boolean   @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz()
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  facility        Facility       @relation(fields: [facilityId], references: [id])
  refreshTokens   RefreshToken[]
  partiesCreated  Party[]        @relation("PartyCreatedBy")
  temperatureLogs TemperatureLog[]

  @@unique([facilityId, email])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  facilityId String    @map("facility_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(200)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user     User     @relation(fields: [userId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  facilityId String      @map("facility_id") @db.Uuid
  tableName  String      @map("table_name") @db.VarChar(100)
  recordId   String      @map("record_id") @db.Uuid
  action     AuditAction
  changedBy  String      @map("changed_by") @db.Uuid
  changedAt  DateTime    @default(now()) @map("changed_at") @db.Timestamptz()
  oldValues  Json?       @map("old_values")
  newValues  Json        @map("new_values")
  reason     String?     @db.Text

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId, tableName, recordId])
  @@index([changedAt])
  @@map("audit_log")
}

// ============================================================
// PHASE 1: PARTIES, COMMODITIES, CHAMBERS (Migration 0002)
// ============================================================

model Party {
  id              String    @id @default(uuid()) @db.Uuid
  facilityId      String    @map("facility_id") @db.Uuid
  name            String    @db.VarChar(200)
  nameUrdu        String?   @map("name_urdu") @db.VarChar(200)
  partyType       PartyType @map("party_type")
  phonePrimary    String    @map("phone_primary") @db.VarChar(20)
  phoneSecondary  String?   @map("phone_secondary") @db.VarChar(20)
  address         String?   @db.Text
  cnic            String?   @db.VarChar(15)
  parentArhtiId   String?   @map("parent_arhti_id") @db.Uuid
  creditLimitPkr  Decimal?  @map("credit_limit_pkr") @db.Decimal(12, 2)
  creditTermsDays Int       @default(30) @map("credit_terms_days")
  isActive        Boolean   @default(true) @map("is_active")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  createdBy       String    @map("created_by") @db.Uuid

  facility     Facility @relation(fields: [facilityId], references: [id])
  parentArhti  Party?   @relation("PartyArhtiLink", fields: [parentArhtiId], references: [id])
  childParties Party[]  @relation("PartyArhtiLink")
  createdByUser User    @relation("PartyCreatedBy", fields: [createdBy], references: [id])

  @@index([facilityId, phonePrimary])
  @@index([facilityId, partyType])
  @@index([parentArhtiId])
  @@map("parties")
}

model Commodity {
  id                      String   @id @default(uuid()) @db.Uuid
  name                    String   @unique @db.VarChar(100)
  unitLabel               String   @map("unit_label") @db.VarChar(20)
  defaultStorageDaysAlert Int?     @map("default_storage_days_alert")
  isActive                Boolean  @default(true) @map("is_active")

  varieties Variety[]
  chambers  Chamber[] @relation("ChamberCommodityRestriction")

  @@map("commodities")
}

model Variety {
  id          String  @id @default(uuid()) @db.Uuid
  commodityId String  @map("commodity_id") @db.Uuid
  name        String  @db.VarChar(100)
  isActive    Boolean @default(true) @map("is_active")

  commodity Commodity @relation(fields: [commodityId], references: [id])

  @@map("varieties")
}

model Chamber {
  id                     String   @id @default(uuid()) @db.Uuid
  facilityId             String   @map("facility_id") @db.Uuid
  name                   String   @db.VarChar(100)
  commodityRestrictionId String?  @map("commodity_restriction") @db.Uuid
  maxCapacityBags        Int      @map("max_capacity_bags")
  temperatureMinC        Decimal? @map("temperature_min_c") @db.Decimal(4, 1)
  temperatureMaxC        Decimal? @map("temperature_max_c") @db.Decimal(4, 1)
  isActive               Boolean  @default(true) @map("is_active")
  notes                  String?  @db.Text

  facility             Facility       @relation(fields: [facilityId], references: [id])
  commodityRestriction Commodity?     @relation("ChamberCommodityRestriction", fields: [commodityRestrictionId], references: [id])
  temperatureLogs      TemperatureLog[]

  @@map("chambers")
}

model TemperatureLog {
  id           String            @id @default(uuid()) @db.Uuid
  chamberId    String            @map("chamber_id") @db.Uuid
  recordedAt   DateTime          @map("recorded_at") @db.Timestamptz()
  temperatureC Decimal           @map("temperature_c") @db.Decimal(4, 1)
  recordedBy   String            @map("recorded_by") @db.Uuid
  source       TemperatureSource @default(MANUAL)

  chamber      Chamber @relation(fields: [chamberId], references: [id])
  recordedByUser User  @relation(fields: [recordedBy], references: [id])

  @@index([chamberId, recordedAt])
  @@map("temperature_logs")
}
