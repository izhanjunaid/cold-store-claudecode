enum AssetCategory {
  COLD_PLANT
  BUILDING
  VEHICLE
  COMPUTER
  OTHER
}

enum DepreciationMethod {
  SLM
  WDV
}

enum FixedAssetStatus {
  PLANNED
  PURCHASED
  IN_SERVICE
  DISPOSED
  WRITTEN_OFF
}

enum DepreciationScheduleStatus {
