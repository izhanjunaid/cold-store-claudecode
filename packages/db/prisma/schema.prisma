  POSTED
}

enum EmployeeType {
  SALARIED
  DAILY_WAGE
}

enum PayrollType {
  MONTHLY_SALARY
  DAILY_WAGES
}

enum PayrollRunStatus {
  DRAFT
  FINALIZED
  PAID
  REVERSED
}

enum ExpenseVoucherStatus {
  DRAFT
  APPROVED
  ACCRUED
  PAID
  CANCELLED
  CONVERTED
}

// ============================================================
// ENUMS (Accounting consolidation — docs/25)
// ============================================================

enum BillStatus {
  DRAFT
  POSTED
  VOID
}

enum WithholdingSection {
  S149
  S153
  S155
}

enum OwnerEquityDirection {
  CAPITAL_IN
  DRAWING
}

enum ExpensePaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
}

enum PartyLoanStatus {
  ACTIVE
  RECOVERED
  WRITTEN_OFF
}

enum EmployeeAdvanceStatus {
