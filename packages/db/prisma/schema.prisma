  PENDING
  CLEARED
  BOUNCED
}

// ============================================================
// ENUMS (Phase 8 — Accounting)
// ============================================================

enum AccountClass {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COST_OF_SERVICE
  EXPENSE
}

enum AccountType {
  HEADER
  DETAIL
}

enum NormalBalance {
  DEBIT
  CREDIT
}

// Which face-of-statement section a HEADER account's children roll up into.
// Null on a header means "no section" — its children fall into the
// statements' unclassified bucket (F-6b), same as before this enum existed.
// Never set on a DETAIL account (only headers define statement structure) or
// on an EQUITY header (equity aggregates by class, not by header — phase/19).
enum StatementSection {
  CURRENT_ASSET
  NON_CURRENT_ASSET
  CURRENT_LIABILITY
  NON_CURRENT_LIABILITY
  REVENUE
  CONTRA_REVENUE
  OTHER_INCOME
  COST_OF_SERVICE
  OPERATING_EXPENSE
  OTHER_EXPENSE
}

// Where an account's cash movements land on the statement of cash flows.
// Null is the normal state: the section is derived from statement_section +
// account_class, and this column exists only to override the few accounts
// where that derivation is wrong (1140 peshgi, 2120 owner loan).
enum CashFlowSection {
  OPERATING
  INVESTING
  FINANCING
}

enum EntryType {
  INVOICE
  PAYMENT
  ADVANCE
  ADVANCE_APPLIED
  CREDIT_NOTE
  ADJUSTMENT
  ACCRUAL
  BAD_DEBT
  REVERSAL
  SPOILAGE
  SPOILAGE_SETTLEMENT
  DEPRECIATION
  ASSET_PURCHASE
  ASSET_DISPOSAL
  PAYROLL
  PAYROLL_PAYMENT
  GOVT_REMITTANCE
  EXPENSE
  PESHGI_ISSUE
  PESHGI_RECOVERY
  PESHGI_WRITE_OFF
  EMPLOYEE_ADVANCE_ISSUE
  EMPLOYEE_ADVANCE_WRITE_OFF
  CHEQUE_CLEARED
  OPENING_BALANCE
  OWNER_EQUITY
  CASH_TRANSFER
  IMPAIRMENT
  BILL
  SUPPLIER_PAYMENT
  TAX_REMITTANCE
  LATE_PAYMENT_SURCHARGE
}

// REVERSED is retired: a reversed entry stays POSTED and records reversed_by
// (migration 0025). CHECK journal_entries_no_reversed_status (0030) forbids it;
// the value itself is dropped in Release 2 (expand-only releases).
enum PostingStatus {
  AUTO_DRAFT
  POSTED
  REVERSED
}

enum CreditNoteStatus {
  ISSUED
  APPLIED
  CANCELLED
}

// ============================================================
// ENUMS (Phase 8B — Cost-side)
