// ============================================================
// EMPLOYEE ADVANCES (Phase 21)
//
// Recovery does not post its own journal entry — it rides inside the
// payroll entry (JE-15/JE-15B) as an additional credit line to 1230,
// alongside the tax/EOBI credit lines that are already there. That is
// why EmployeeAdvanceRecovery links to a payroll run/line rather than
// to its own JournalEntry: the entry it belongs to is the payroll run's.
// ============================================================

model EmployeeAdvance {
