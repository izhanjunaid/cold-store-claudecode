  /// Deprecated (docs/25 L-19): no longer read — the cash-flow section is derived
  /// from the header's statement section. Dropped in Release 2.
  cashFlowSection   CashFlowSection?  @map("cash_flow_section")
  isSystemAccount   Boolean           @default(false) @map("is_system_account")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  /// Cash or a bank/wallet account: what every "paid from" picker offers and what the
  /// cash-flow statement counts. Frozen once the account has postings.
  isCashEquivalent   Boolean @default(false) @map("is_cash_equivalent")
  /// False on balances only their own documents may move (cheques in hand, accrued
  /// revenue, salaries payable, peshgi, advances, derived equity).
  allowManualPosting Boolean @default(true) @map("allow_manual_posting")
  /// Every line must name a party (receivable and payable control accounts), so the
