// ============================================================
// PHASE 14: ROOMS & RACKS (Migration 0005)
// UI calls a Chamber a "Room"; racks are sub-locations within it.
// A lot's bags may be spread over several racks of its chamber
// (lot_rack_placements); unallocated bags are implicitly "unplaced".
// ============================================================

enum LotMovementType {
  PLACEMENT
  RACK_TRANSFER
  ROOM_TRANSFER
  WITHDRAWAL_PICK
}

model Rack {
  id              String  @id @default(uuid()) @db.Uuid
  facilityId      String  @map("facility_id") @db.Uuid
  chamberId       String  @map("chamber_id") @db.Uuid
  name            String  @db.VarChar(50)
  maxCapacityBags Int     @map("max_capacity_bags")
  position        Int     @default(0)
  isActive        Boolean @default(true) @map("is_active")
  notes           String? @db.Text

  facility      Facility           @relation(fields: [facilityId], references: [id])
  chamber       Chamber            @relation(fields: [chamberId], references: [id])
  placements    LotRackPlacement[]
  movementsFrom LotMovement[]      @relation("MovementFromRack")
  movementsTo   LotMovement[]      @relation("MovementToRack")

  @@unique([chamberId, name])
  @@index([chamberId, isActive])
  @@map("racks")
}

model LotRackPlacement {
  id         String   @id @default(uuid()) @db.Uuid
  facilityId String   @map("facility_id") @db.Uuid
  lotId      String   @map("lot_id") @db.Uuid
  rackId     String   @map("rack_id") @db.Uuid
  bags       Int
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  facility Facility @relation(fields: [facilityId], references: [id])
  lot      Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  rack     Rack     @relation(fields: [rackId], references: [id])

  @@unique([lotId, rackId])
  @@index([rackId])
  @@index([lotId])
  @@map("lot_rack_placements")
}

model LotMovement {
  id            String          @id @default(uuid()) @db.Uuid
  facilityId    String          @map("facility_id") @db.Uuid
  lotId         String          @map("lot_id") @db.Uuid
  movementType  LotMovementType @map("movement_type")
  fromChamberId String?         @map("from_chamber_id") @db.Uuid
  toChamberId   String?         @map("to_chamber_id") @db.Uuid
  fromRackId    String?         @map("from_rack_id") @db.Uuid
  toRackId      String?         @map("to_rack_id") @db.Uuid
  bags          Int
  reason        String?         @db.Text
  movedBy       String          @map("moved_by") @db.Uuid
  movedAt       DateTime        @default(now()) @map("moved_at") @db.Timestamptz()

  facility    Facility @relation(fields: [facilityId], references: [id])
  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  fromChamber Chamber? @relation("MovementFromChamber", fields: [fromChamberId], references: [id])
  toChamber   Chamber? @relation("MovementToChamber", fields: [toChamberId], references: [id])
  fromRack    Rack?    @relation("MovementFromRack", fields: [fromRackId], references: [id])
  toRack      Rack?    @relation("MovementToRack", fields: [toRackId], references: [id])
  movedByUser User     @relation("LotMovementMovedBy", fields: [movedBy], references: [id])

  @@index([lotId, movedAt])
  @@map("lot_movements")
}

/// An owner of the facility, and the two equity accounts that are theirs.
///
/// Before this, a partner was not a thing: the statements worked out whose an
/// account was by reading its normal balance (DEBIT = drawings, CREDIT =
/// capital). Nothing linked one owner's two accounts, and nothing knew a partner
/// needed both — which is how a live chart ended up with an owner who had a
/// drawings account, no capital account, and no way to notice.
model Partner {
  id                  String    @id @default(uuid()) @db.Uuid
  facilityId          String    @map("facility_id") @db.Uuid
  name                String    @db.VarChar(200)
  /// EQUITY / DETAIL / CREDIT, under header 3100.
  capitalAccountCode  String    @map("capital_account_code") @db.VarChar(10)
  /// EQUITY / DETAIL / DEBIT, under header 3200.
  drawingsAccountCode String    @map("drawings_account_code") @db.VarChar(10)
  admittedOn          DateTime  @map("admitted_on") @db.Date
  /// Set when they leave. Their accounts and history stay; only the profit
  /// share stops, which the effective-dated share rows already express.
  retiredOn           DateTime? @map("retired_on") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  /// Lets payroll refuse to employ an owner: an owner's pay is a drawing (C-21).
  cnic                String?   @db.VarChar(15)

  facility        Facility              @relation(fields: [facilityId], references: [id])
  shares          PartnerProfitShare[]
  equityMovements OwnerEquityMovement[]

  /// One account belongs to one partner. Without these, two partners could name
  /// the same account and every per-owner figure would double-count.
  @@unique([facilityId, capitalAccountCode])
  @@unique([facilityId, drawingsAccountCode])
  @@unique([facilityId, name])
  @@map("partners")
}

/// How the result is divided, from a date. Effective-dated rather than a single
/// current value because the year a partner joins has to split at the old ratio
/// up to the admission date and the new one after it — the part that is
/// genuinely error-prone by hand.
model PartnerProfitShare {
  id            String   @id @default(uuid()) @db.Uuid
  facilityId    String   @map("facility_id") @db.Uuid
  partnerId     String   @map("partner_id") @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  /// Relative weight, not a percentage: the allocator normalises over the
  /// partners effective on the date, so 1/1 and 50/50 mean the same thing and
  /// neither can fail to add to 100.
  weight        Decimal  @db.Decimal(12, 4)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  facility Facility @relation(fields: [facilityId], references: [id])
  partner  Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, effectiveFrom])
  @@index([facilityId, effectiveFrom])
  @@map("partner_profit_shares")
}

// ============================================================
// ACCOUNTING CONSOLIDATION (docs/25) — migrations 0027–0030
//
// Composite foreign keys to chart_of_accounts on pre-existing config columns
// (rate_plans, service_charges, payments, fixed_assets, expense_vouchers,
// party_loans, employee_advances) exist in SQL only (0030): Prisma cannot model
// an optional relation over [facilityId (required), code (optional)]. The same
// is true of partners since 0026. User references on the tables below
// (created_by, voided_by) are SQL foreign keys kept as plain scalars here, the
// same as payment_allocations.voided_by.
// ============================================================

/// A supplier bill: what the facility owes, recognised on the bill date
/// (docs/25 C-01/C-02). Posting credits the supplier control account (Trade
/// Payables) with the supplier on the line; payment state is derived from
/// supplier_payment_allocations, never stored.
model Bill {
  id                     String     @id @default(uuid()) @db.Uuid
  facilityId             String     @map("facility_id") @db.Uuid
  billNumber             String?    @map("bill_number") @db.VarChar(20)
  supplierPartyId        String     @map("supplier_party_id") @db.Uuid
  billDate               DateTime   @map("bill_date") @db.Date
  dueDate                DateTime?  @map("due_date") @db.Date
  supplierReference      String?    @map("supplier_reference") @db.VarChar(100)
  description            String     @db.VarChar(500)
  subtotalPkr            Decimal    @map("subtotal_pkr") @db.Decimal(14, 2)
  inputTaxPkr            Decimal    @default(0) @map("input_tax_pkr") @db.Decimal(14, 2)
  totalPkr               Decimal    @map("total_pkr") @db.Decimal(14, 2)
  status                 BillStatus @default(DRAFT)
  bookType               BookType   @default(PACCI) @map("book_type")
  journalEntryId         String?    @unique @map("journal_entry_id") @db.Uuid
  /// Set when the bill was converted from a pre-payables accrued expense voucher.
  legacyExpenseVoucherId String?    @unique @map("legacy_expense_voucher_id") @db.Uuid
  voidedAt               DateTime?  @map("voided_at") @db.Timestamptz()
  voidedBy               String?    @map("voided_by") @db.Uuid
  voidReason             String?    @map("void_reason") @db.Text
  notes                  String?    @db.Text
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  createdBy              String     @map("created_by") @db.Uuid

  facility             Facility                    @relation(fields: [facilityId], references: [id])
  supplier             Party                       @relation(fields: [supplierPartyId], references: [id])
  journalEntry         JournalEntry?               @relation(fields: [journalEntryId], references: [id])
  legacyExpenseVoucher ExpenseVoucher?             @relation(fields: [legacyExpenseVoucherId], references: [id])
  lines                BillLine[]
  allocations          SupplierPaymentAllocation[]

  @@unique([facilityId, billNumber], map: "bills_facility_number_key")
  @@index([facilityId, supplierPartyId], map: "bills_facility_supplier_idx")
  @@index([facilityId, status], map: "bills_facility_status_idx")
  @@index([facilityId, billDate], map: "bills_facility_date_idx")
  @@map("bills")
}

model BillLine {
  id                 String  @id @default(uuid()) @db.Uuid
  billId             String  @map("bill_id") @db.Uuid
  facilityId         String  @map("facility_id") @db.Uuid
  lineNumber         Int     @map("line_number")
  expenseAccountCode String  @map("expense_account_code") @db.VarChar(10)
  description        String  @db.VarChar(300)
  amountPkr          Decimal @map("amount_pkr") @db.Decimal(14, 2)

  bill    Bill            @relation(fields: [billId], references: [id], onDelete: Cascade)
  account ChartOfAccounts @relation(fields: [facilityId, expenseAccountCode], references: [facilityId, accountCode], onDelete: Restrict, onUpdate: Restrict, map: "bill_lines_account_fkey")

  @@unique([billId, lineNumber], map: "bill_lines_bill_line_key")
  @@map("bill_lines")
}

/// A payment to a supplier. Gross settles the supplier account; the supplier
/// receives gross less the tax withheld, which is owed to the FBR (docs/25 C-09).
model SupplierPayment {
  id                 String              @id @default(uuid()) @db.Uuid
  facilityId         String              @map("facility_id") @db.Uuid
  paymentNumber      String?             @map("payment_number") @db.VarChar(20)
  supplierPartyId    String              @map("supplier_party_id") @db.Uuid
  paymentDate        DateTime            @map("payment_date") @db.Date
  paymentMethod      PaymentMethod       @map("payment_method")
  assetAccountCode   String              @map("asset_account_code") @db.VarChar(10)
  grossAmountPkr     Decimal             @map("gross_amount_pkr") @db.Decimal(14, 2)
  withholdingSection WithholdingSection? @map("withholding_section")
  withholdingRatePct Decimal?            @map("withholding_rate_pct") @db.Decimal(5, 2)
  withholdingPkr     Decimal             @default(0) @map("withholding_pkr") @db.Decimal(14, 2)
  netPaidPkr         Decimal             @map("net_paid_pkr") @db.Decimal(14, 2)
  certificateNumber  String?             @map("certificate_number") @db.VarChar(50)
  referenceNumber    String?             @map("reference_number") @db.VarChar(100)
  bookType           BookType            @default(PACCI) @map("book_type")
  journalEntryId     String?             @unique @map("journal_entry_id") @db.Uuid
  voidedAt           DateTime?           @map("voided_at") @db.Timestamptz()
  voidedBy           String?             @map("voided_by") @db.Uuid
  voidReason         String?             @map("void_reason") @db.Text
  notes              String?             @db.Text
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  createdBy          String              @map("created_by") @db.Uuid

  facility     Facility                    @relation(fields: [facilityId], references: [id])
  supplier     Party                       @relation(fields: [supplierPartyId], references: [id])
  account      ChartOfAccounts             @relation(fields: [facilityId, assetAccountCode], references: [facilityId, accountCode], onDelete: Restrict, onUpdate: Restrict, map: "supplier_payments_account_fkey")
  journalEntry JournalEntry?               @relation(fields: [journalEntryId], references: [id])
  allocations  SupplierPaymentAllocation[]

  @@unique([facilityId, paymentNumber], map: "supplier_payments_facility_number_key")
  @@index([facilityId, supplierPartyId], map: "supplier_payments_facility_supplier_idx")
  @@index([facilityId, paymentDate], map: "supplier_payments_facility_date_idx")
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id                 String    @id @default(uuid()) @db.Uuid
  supplierPaymentId  String    @map("supplier_payment_id") @db.Uuid
  billId             String    @map("bill_id") @db.Uuid
  allocatedAmountPkr Decimal   @map("allocated_amount_pkr") @db.Decimal(14, 2)
  voidedAt           DateTime? @map("voided_at") @db.Timestamptz()
  voidedBy           String?   @map("voided_by") @db.Uuid

  supplierPayment SupplierPayment @relation(fields: [supplierPaymentId], references: [id])
  bill            Bill            @relation(fields: [billId], references: [id])

  @@index([supplierPaymentId], map: "supplier_payment_allocations_payment_idx")
  @@index([billId], map: "supplier_payment_allocations_bill_idx")
  @@map("supplier_payment_allocations")
}

/// One statutory liability paid over for one period: EOBI (2060/2061), s.149
/// (2070), s.153 (2071), s.155 (2072). Replaces per-payroll-run remittance and
/// the document-less JE-29 (docs/25 C-10).
model TaxRemittance {
  id                   String    @id @default(uuid()) @db.Uuid
  facilityId           String    @map("facility_id") @db.Uuid
  liabilityAccountCode String    @map("liability_account_code") @db.VarChar(10)
  periodYear           Int       @map("period_year")
  periodMonth          Int       @map("period_month")
  remittanceDate       DateTime  @map("remittance_date") @db.Date
  amountPkr            Decimal   @map("amount_pkr") @db.Decimal(14, 2)
  paidFromAccountCode  String    @map("paid_from_account_code") @db.VarChar(10)
  /// The FBR / EOBI computerised payment receipt (CPR / challan) number.
  challanNumber        String?   @map("challan_number") @db.VarChar(50)
  bookType             BookType  @default(PACCI) @map("book_type")
  journalEntryId       String?   @unique @map("journal_entry_id") @db.Uuid
  voidedAt             DateTime? @map("voided_at") @db.Timestamptz()
  voidedBy             String?   @map("voided_by") @db.Uuid
  voidReason           String?   @map("void_reason") @db.Text
  notes                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  createdBy            String    @map("created_by") @db.Uuid

  facility         Facility        @relation(fields: [facilityId], references: [id])
  liabilityAccount ChartOfAccounts @relation("TaxRemittanceLiability", fields: [facilityId, liabilityAccountCode], references: [facilityId, accountCode], onDelete: Restrict, onUpdate: Restrict, map: "tax_remittances_liability_fkey")
  paidFromAccount  ChartOfAccounts @relation("TaxRemittancePaidFrom", fields: [facilityId, paidFromAccountCode], references: [facilityId, accountCode], onDelete: Restrict, onUpdate: Restrict, map: "tax_remittances_paid_from_fkey")
  journalEntry     JournalEntry?   @relation(fields: [journalEntryId], references: [id])

  @@index([facilityId, liabilityAccountCode, periodYear, periodMonth], map: "tax_remittances_facility_period_idx")
  @@map("tax_remittances")
}

/// Money moved between two of the facility's own cash-equivalent accounts
/// (docs/25 C-44) — a document, so it has a history and can be voided.
model CashTransfer {
  id              String    @id @default(uuid()) @db.Uuid
  facilityId      String    @map("facility_id") @db.Uuid
  transferDate    DateTime  @map("transfer_date") @db.Date
  fromAccountCode String    @map("from_account_code") @db.VarChar(10)
  toAccountCode   String    @map("to_account_code") @db.VarChar(10)
  amountPkr       Decimal   @map("amount_pkr") @db.Decimal(14, 2)
  reference       String?   @db.VarChar(100)
  notes           String?   @db.Text
  bookType        BookType  @default(PACCI) @map("book_type")
  journalEntryId  String?   @unique @map("journal_entry_id") @db.Uuid
  voidedAt        DateTime? @map("voided_at") @db.Timestamptz()
  voidedBy        String?   @map("voided_by") @db.Uuid
  voidReason      String?   @map("void_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  createdBy       String    @map("created_by") @db.Uuid

  facility     Facility        @relation(fields: [facilityId], references: [id])
  fromAccount  ChartOfAccounts @relation("CashTransferFrom", fields: [facilityId, fromAccountCode], references: [facilityId, accountCode], onDelete: Restrict, onUpdate: Restrict, map: "cash_transfers_from_fkey")
  toAccount    ChartOfAccounts @relation("CashTransferTo", fields: [facilityId, toAccountCode], references: [facilityId, accountCode], onDelete: Restrict, onUpdate: Restrict, map: "cash_transfers_to_fkey")
  journalEntry JournalEntry?   @relation(fields: [journalEntryId], references: [id])

  @@index([facilityId, transferDate], map: "cash_transfers_facility_date_idx")
  @@map("cash_transfers")
}

/// An owner putting money in or taking it out (docs/25 L-23). The equity account
/// is derived from the partner and the direction, never chosen separately.
model OwnerEquityMovement {
  id              String               @id @default(uuid()) @db.Uuid
  facilityId      String               @map("facility_id") @db.Uuid
  partnerId       String               @map("partner_id") @db.Uuid
  direction       OwnerEquityDirection
  movementDate    DateTime             @map("movement_date") @db.Date
  amountPkr       Decimal              @map("amount_pkr") @db.Decimal(14, 2)
  cashAccountCode String               @map("cash_account_code") @db.VarChar(10)
  note            String?              @db.VarChar(300)
  bookType        BookType             @default(PACCI) @map("book_type")
  journalEntryId  String?              @unique @map("journal_entry_id") @db.Uuid
  voidedAt        DateTime?            @map("voided_at") @db.Timestamptz()
  voidedBy        String?              @map("voided_by") @db.Uuid
  voidReason      String?              @map("void_reason") @db.Text
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  createdBy       String               @map("created_by") @db.Uuid

  facility     Facility        @relation(fields: [facilityId], references: [id])
  partner      Partner         @relation(fields: [partnerId], references: [id])
  cashAccount  ChartOfAccounts @relation(fields: [facilityId, cashAccountCode], references: [facilityId, accountCode], onDelete: Restrict, onUpdate: Restrict, map: "owner_equity_movements_cash_fkey")
  journalEntry JournalEntry?   @relation(fields: [journalEntryId], references: [id])

  @@index([facilityId, partnerId], map: "owner_equity_movements_facility_partner_idx")
  @@map("owner_equity_movements")
}
