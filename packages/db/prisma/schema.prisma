generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; "debian-openssl-3.0.x" is the Docker runtime
  // (node:20-bookworm-slim ships OpenSSL 3.x) so the matching query engine is
  // generated into the image and the API can start in the container.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  OWNER
  MANAGER
  ACCOUNTANT
  OPERATOR
  SECURITY
  VIEWER
}

enum AuditAction {
  INSERT
  UPDATE
  DELETE
}

enum OtpPurpose {
  PASSWORD_RESET
  LOGIN_2FA
}

// ============================================================
// ENUMS (Phase 1)
// ============================================================

enum PartyType {
  FARMER
  TRADER
  ARHTI
  BUYER
  OTHER
  SUPPLIER
}

enum TemperatureSource {
  MANUAL
  SENSOR
}

// ============================================================
// ENUMS (Phase 2)
// ============================================================

enum RateType {
